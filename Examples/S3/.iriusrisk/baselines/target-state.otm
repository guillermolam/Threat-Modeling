dataflows:
  - {id: client-to-waf, name: Request content, source: internet-client, destination: edge-waf}
  - {id: waf-to-edge, name: Forward allowed request, source: edge-waf, destination: cloudfront-oac}
  - {id: edge-to-public, name: Read public origin object, source: cloudfront-oac, destination: s3-public}
  - {id: partner-to-role, name: Assume partner writer role, source: partner-ingestion, destination: partner-writer-role}
  - {id: partner-role-to-regulated, name: Write partner prefix, source: partner-writer-role, destination: s3-regulated}
  - {id: upload-to-quarantine, name: Upload untrusted object, source: ugc-uploader, destination: s3-ugc-quarantine}
  - {id: quarantine-to-scanner, name: Scan quarantined version, source: s3-ugc-quarantine, destination: malware-scanner}
  - {id: scanner-to-promotion, name: Submit scan verdict, source: malware-scanner, destination: promotion-worker}
  - {id: promotion-read-version, name: Read approved version, source: promotion-worker, destination: s3-ugc-quarantine}
  - {id: promotion-write-published, name: Promote approved object, source: promotion-worker, destination: s3-ugc-published}
  - {id: app-to-public-role, name: Obtain public read authorization, source: application-compute, destination: public-reader-role}
  - {id: public-role-to-bucket, name: Read public content, source: public-reader-role, destination: s3-public}
  - {id: reader-to-regulated-role, name: Obtain regulated read authorization, source: version-pinned-reader, destination: regulated-reader-role}
  - {id: pinned-read, name: Read exact export version, source: regulated-reader-role, destination: s3-regulated}
  - {id: public-key-use, name: Use public content key, source: s3-public, destination: kms-public}
  - {id: regulated-key-use, name: Use regulated data key, source: s3-regulated, destination: kms-regulated}
  - {id: quarantine-key-use, name: Use UGC key, source: s3-ugc-quarantine, destination: kms-ugc}
  - {id: published-key-use, name: Use UGC key, source: s3-ugc-published, destination: kms-ugc}
  - {id: bucket-data-events, name: Record S3 object activity, source: s3-regulated, destination: s3-data-logging}
  - {id: logs-to-detection, name: Evaluate object activity, source: s3-data-logging, destination: data-event-detection}
  - {id: agent-read, name: Read approved analytics export, source: analytics-agent, destination: version-pinned-reader}
