# macOS
.DS_Store

# Local Claude/agent settings
.claude/settings.local.json

# Threat-modeling skill: setup-only copies, build and test artifacts
.cowork/dist/
.cowork/package/
.cowork/vendor/
.cowork/smoke/

# FUSE temp files
.fuse_hidden*

# SQLite knowledge bases
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Terraform / Terragrunt state and caches
*.tfstate
*.tfstate.*
.terraform/
.terragrunt-cache/
.terraform.lock.hcl
Examples/S3/infra/.tfstate/
.threatforest/.env

# Repository-local pinned tool binaries
.tools/

# Repository-owned local inference runtime state and debug logs
.tools/runtime/

# Python unit-test bytecode
__pycache__/
*.py[cod]

# Architecture evidence: raw plans/logs are sensitive and always ephemeral.
Examples/S3/architecture/.evidence/
Examples/S3/architecture/**/*.tfplan
